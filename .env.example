# Copia este archivo a ".env" y completa los valores.
# Instrucciones detalladas paso a paso en README.md

# Base de datos. Para desarrollo local con SQLite (no cambies esto salvo que
# despliegues con PostgreSQL, ver README seccion "Despliegue en produccion").
DATABASE_URL="file:./dev.db"

# NextAuth: URL publica de la app y una clave secreta aleatoria.
# Genera una clave con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="reemplaza-esto-por-una-clave-aleatoria-larga"

# Solo se permite iniciar sesion con correos de este dominio institucional.
DOMINIO_PERMITIDO="duoc.cl"

# Clave secreta para proteger el endpoint de notificaciones automaticas
# (/api/cron/notificaciones). Genera una con: openssl rand -hex 24
CRON_SECRET="reemplaza-esto-tambien"

# --- Envio de correos (SMTP) ---
# Puedes usar el SMTP de Outlook/Office 365 de la institucion, Gmail con
# contrasena de aplicacion, o un servicio como Resend/Brevo. Ver README.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@duoc.cl"
SMTP_PASSWORD="tu-contrasena-o-clave-de-aplicacion"
SMTP_FROM="Cumplimiento SSO Duoc UC <tu-correo@duoc.cl>"

# Tamano maximo de archivo de evidencia en MB
MAX_UPLOAD_MB="10"
